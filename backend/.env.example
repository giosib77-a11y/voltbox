# ─────────────────────────────────────────────────────────────────────────────
#  VoltBox backend — ლოკალური კონფიგი.  ⚠️ ეს ფაილი git-ში არ ხვდება.
# ─────────────────────────────────────────────────────────────────────────────

# 1. ჩასვი Supabase-ის Session pooler URI და [YOUR-PASSWORD] შეცვალე რეალურით.
#    სქემას (`postgresql://` → `postgresql+asyncpg://`) კოდი თვითონ გადააკეთებს,
#    ასე რომ ზუსტად ისე ჩასვი, როგორც Supabase-მა მოგცა.
# ---- აქტიური კავშირი -------------------------------------------------------
# ლოკალური Postgres (Docker) — დეველოპმენტისა და ტესტებისთვის
DATABASE_URL=postgresql://voltbox:voltbox@localhost:55432/voltbox

# Supabase-ზე გადასართავად: ზემოთა ხაზი დააკომენტარე და ეს გაააქტიურე
# (Session pooler URI, [YOUR-PASSWORD] რეალურით ჩანაცვლებული)
# DATABASE_URL=postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# 2. JWT-ის ხელმოწერის გასაღები. დააგენერირე და ჩასვი `=`-ის შემდეგ:
#    python -c "import secrets;print(secrets.token_urlsafe(48))"
# ⚠️ ბრძანება ან კომენტარი იმავე ხაზზე არ დაწერო. `JWT_SECRET=  # ...`-ში
# python-dotenv კომენტარს მნიშვნელობად კითხულობს: ის ≥32 სიმბოლოს შემოწმებას
# გადის და გასაღები ხდება ტექსტი, რომელიც ამ ფაილის ყველა მკითხველმა იცის.
# ცარიელით სერვერი გაშვებაზე ჩერდება.
JWT_SECRET=

# --- დანარჩენს ნაგულისხმევად ვტოვებთ ---------------------------------------
# ⚠️ ყველაზე მნიშვნელოვანი ცვლადი ამ ფაილში.
# დეპლოიზე **აუცილებლად** `production` (ან `staging`). თუ არ დააყენე,
# ნაგულისხმევი `development` ერთდროულად ხსნის ყველა ამ დაცვას:
#   /docs და /openapi.json საჯარო ხდება (მთელი admin API-ს სქემა)
#   refresh cookie კარგავს `Secure`-ს
#   სურათები პროცესის მეხსიერებაში იწერება და ქრება
#   gunicorn-ის გაშვებისას შემოწმებები გამოტოვდება: FORWARDED_ALLOW_IPS,
#   TRUSTED_HOSTS, CORS_ORIGINS, REDIS_URL და კავშირების ბიუჯეტი
# ამიტომ gunicorn სახელდაუდებელ გარემოში გაშვებაზე ჩერდება.
APP_ENV=development

# ვის უშვებს ბრაუზერი API-სთან: storefront-ის origin, ანუ სქემა და host-ი
# path-ის გარეშე. რამდენიმე — მძიმით.
# ⚠️ დეპლოიზე სავალდებულოა. gunicorn გაშვებაზე ჩერდება, თუ ცარიელია, შეიცავს
# `*`-ს ან local origin-ს (localhost, 127.0.0.1, ::1), ან ელემენტს, რომელიც
# origin არ არის (`voltbox.ge` სქემის გარეშე, `https://voltbox.ge/shop`
# path-ით). სწორი ფორმის, მაგრამ სხვა დომენის origin-ს ვერ დაიჭერს — სერვერი
# აიწევს და ბრაუზერი ყველა მოთხოვნას დაბლოკავს.
# დეპლოიზე: CORS_ORIGINS=https://voltbox.ge
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# რომელ `Host` header-ს მიიღოს API — ეს API-ს საკუთარი სახელია და არა
# storefront-ის დომენი. storefront-იდან ბრაუზერი აგზავნის `Host: api.voltbox.ge`
# და `Origin: https://voltbox.ge`; Origin-ი CORS_ORIGINS-ის საქმეა.
# `voltbox.ge,www.voltbox.ge` აქ ყველა მოთხოვნას, health check-საც,
# `400 Invalid host header`-ით უარყოფს (docs/deployment.md §2).
# `*` = შემოწმება სრულად გამორთულია — სერვერი ნებისმიერ სახელზე პასუხობს.
# ⚠️ დეპლოიზე სავალდებულოა: დაუყენებლად, ცარიელით ან `*`-ით gunicorn
# გაშვებაზე ჩერდება. `*` სხვა სახელებთან ერთად ლოკალურადაც უარყოფილია.
# Render-ის `<service>.onrender.com`-ს აპი თვითონ ამატებს — აქ არ იწერება.
# დეპლოიზე: TRUSTED_HOSTS=api.voltbox.ge
TRUSTED_HOSTS=*

# ბაზასთან TLS. `require` შიფრავს, მაგრამ სერვერს **არ ამოწმებს** (MITM-ისგან
# არ იცავს). `verify-full` სრული დაცვაა და ითხოვს DB_SSL_ROOT_CERT-ს:
# Supabase → Settings → Database → SSL Configuration → Download.
DB_SSL_MODE=require
DB_SSL_ROOT_CERT=

# `true` ყველა SQL-ს ლოგავს, მნიშვნელობების გარეშე: app/db/session.py-ის
# hide_parameters=True მათ ადგილას „[SQL parameters hidden ...]"-ს წერს.
# გაზომილი: bind-ით გადაცემული მნიშვნელობა ლოგში არც query-სთან ჩანს, არც
# შედეგში. დეპლოიზე მაინც არა — ყოველი მოთხოვნის ყოველი query ლოგში წავა.
DB_ECHO=false

# --- სიხშირის შეზღუდვა ------------------------------------------------------
# ცარიელი = მთვლელები პროცესის მეხსიერებაში. ეს მხოლოდ ერთი პროცესისთვისაა
# სწორი; Dockerfile ორ worker-ს უშვებს, ანუ „5 შესვლა წუთში" ათად იქცევა.
# ⚠️ ამიტომ დეპლოიზე, თუ WEB_CONCURRENCY > 1 (ნაგულისხმევი 2), ცარიელით
# gunicorn გაშვებაზე ჩერდება: ან REDIS_URL, ან WEB_CONCURRENCY=1.
REDIS_URL=

# ვის უნდა დაუჯეროს gunicorn-მა კლიენტის IP-ის შესახებ (`X-Forwarded-For`).
# ⚠️ production/staging-ში სავალდებულოა — თუ არ არის, სერვერი გაშვებაზე
# ჩერდება (იხ. gunicorn.conf.py). `*` აკრძალულია: მაშინ ნებისმიერს შეუძლია
# header-ით თავისი IP აირჩიოს და ლიმიტს გვერდი აუაროს.
# დეპლოიზე — proxy-ის მისამართი. `127.0.0.1` შემოწმებას გადის, მაგრამ სწორია
# მხოლოდ მაშინ, როცა proxy კონტეინერის loopback-ს იზიარებს; სხვა შემთხვევაში
# ყველა მოთხოვნა proxy-ს მიეწერება და მთელ საიტს ერთი ლიმიტი ექნება.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- ბაზის კავშირები --------------------------------------------------------
# თითო worker თავის pool-ს ატარებს, ამიტომ დაკავებული კავშირების ჭერია
#
#     WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
#
# ნაგულისხმევად: 2 x (5 + 10) = 30.
#
# Supabase-ის მცირე ინსტანსი 60-ს უშვებს, საიდანაც 3 superuser-ისთვისაა
# დაცული და ~20-ს თვითონ Supabase-ის სერვისები იკავებენ (PostgREST, Realtime,
# Storage, GoTrue). დარჩენილი ჩვენია.
#
# ⚠️ ლიმიტს რომ გადააჭარბო, Postgres ახალ კავშირს აღარ მიიღებს — საიტი
# დატვირთვისას შემთხვევით 500-ებს დააბრუნებს და შეცდომაში pool არსად ჩანს.
# ამიტომ gunicorn გაშვებაზე ამ არითმეტიკას ამოწმებს (gunicorn.conf.py).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# ჯამური ბიუჯეტი. 0 = შემოწმება გამორთულია (ბაზა სხვას არ უზიარებ).
DB_CONNECTION_BUDGET=30

SHIPPING_FREE_THRESHOLD=150
SHIPPING_FLAT_FEE=5
LOW_STOCK_THRESHOLD=3
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=100

# 3. Supabase Storage — პროდუქტების სურათებისთვის.
# ⚠️ დეპლოიზე სავალდებულოა. ორივეს გარეშე production-ში/staging-ში სერვერი
# აიწევს, მაგრამ admin-ის ყოველი მოთხოვნა, რომელსაც სურათების საცავი სჭირდება,
# RuntimeError-ით (500) ჩავარდება — სხვაგვარად სურათები მეხსიერებაში
# ჩაიწერებოდა და დაიკარგებოდა. გაშვებისას ეს არსად ჩანს.
# SERVICE_ROLE_KEY მხოლოდ backend-ზეა — ბრაუზერში არასოდეს.
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ატვირთვის ზღვრები — დიდი ფაილითა და „pixel bomb"-ით დატვირთვისგან.
# MAX_IMAGE_DECODE_BYTES — რამდენი მეხსიერება შეიძლება დაჯდეს ერთ ატვირთვის
# გაშლამ (და არა რამდენი იწონის ფაილი). პიქსელის ფასი ფორმატზეა დამოკიდებული,
# ამიტომ ზღვარი მეხსიერებაშია და პიქსელების ლიმიტს მისგან storage.py ითვლის:
# 100 MiB → JPEG 13.3 MP, PNG 8.3 MP, WebP 1.9 MP. ზღვარი მხოლოდ იმ სურათს
# ეხება, რომელიც MAX_STORED_EDGE-ს სცდება — რაც ამ ზომაშია, არ იშლება.
# პროცესის ჭერი =
# WEB_CONCURRENCY × ეს მნიშვნელობა — იხ. docs/deployment.md, „მეხსიერების ბიუჯეტი".
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_DECODE_BYTES=104857600

# --- ავტორიზაცია -----------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ბრუტფორსი ანგარიშზე. `/auth/login`-ის ლიმიტი IP-ზე ითვლის, ათასი ნაქირავები
# proxy კი ათასჯერ მეტ ცდას იძლევა ერთ ელ. ფოსტაზე. ეს მთვლელი ანგარიშზეა —
# ერთადერთი, რაც ყველა მცდელობას საერთო აქვს.
#
# ⚠️ ფასი: ვინც ელ. ფოსტას იცის, შეუძლია ანგარიში განგებ ჩაკეტოს. ეს დროებითია
# (ვადა თავისით გადის) და არსებულ სესიას არ ეხება — refresh აქ არ გადის.
MAX_FAILED_LOGINS=10
LOGIN_LOCK_MINUTES=15

# refresh-ტოკენი httpOnly cookie-ში მიდის — JavaScript-ს ის არასოდეს ხედავს.
# დაუყენებელი REFRESH_COOKIE_SECURE = „უსაფრთხო, თუ ეს development ან test არ
# არის". Secure cookie ჩვეულებრივ http-ზე ბრაუზერს საერთოდ არ ინახავს, ანუ
# ლოკალური შესვლა ჩუმად ჩავარდებოდა.
# ⚠️ ცარიელი `REFRESH_COOKIE_SECURE=` დაუყენებელი არ არის: ის boolean-ად არ
# იკითხება და სერვერი გაშვებაზე ჩერდება. ან `true`/`false`, ან ხაზი კომენტარად.
REFRESH_COOKIE_NAME=voltbox_refresh
# REFRESH_COOKIE_SECURE=
REFRESH_COOKIE_SAMESITE=strict
# ცარიელი = `{API_V1_PREFIX}/auth`. თუ proxy API-ს სხვა გარე prefix-ით აწვდის,
# აქ ის ჩაწერე — cookie-ს Path ისეთი უნდა იყოს, როგორსაც *ბრაუზერი* ხედავს.
REFRESH_COOKIE_PATH=

# მაღაზიის საჯარო მისამართი, ტრეილინგ სლეშის გარეშე.
#
# sitemap.xml-ის ყველა ბმული აქედან შენდება. API ცალკე ჰოსტზეა, ამიტომ
# მოთხოვნიდან აღებული მისამართი crawler-ს API-ზე მიუთითებდა და ყველა ბმული
# 404-ს დააბრუნებდა.
SITE_URL=http://localhost:5173
