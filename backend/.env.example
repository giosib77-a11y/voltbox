# ─────────────────────────────────────────────────────────────────────────────
#  VoltBox backend — ლოკალური კონფიგი.  ⚠️ ეს ფაილი git-ში არ ხვდება.
# ─────────────────────────────────────────────────────────────────────────────

# 1. ჩასვი Supabase-ის Session pooler URI და [YOUR-PASSWORD] შეცვალე რეალურით.
#    სქემას (`postgresql://` → `postgresql+asyncpg://`) კოდი თვითონ გადააკეთებს,
#    ასე რომ ზუსტად ისე ჩასვი, როგორც Supabase-მა მოგცა.
# ---- აქტიური კავშირი -------------------------------------------------------
# ლოკალური Postgres (Docker) — დეველოპმენტისა და ტესტებისთვის
DATABASE_URL=postgresql://voltbox:voltbox@localhost:55432/voltbox

# Supabase-ზე გადასართავად: ზემოთა ხაზი დააკომენტარე და ეს გაააქტიურე
# (Session pooler URI, [YOUR-PASSWORD] რეალურით ჩანაცვლებული)
# DATABASE_URL=postgresql://postgres.jnfokdczfpcysnqiwask:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# 2. JWT-ის ხელმოწერის გასაღები — ქვემოთ დაგენერირებული მნიშვნელობა.
JWT_SECRET=  # python -c "import secrets;print(secrets.token_urlsafe(48))"

# --- დანარჩენს ნაგულისხმევად ვტოვებთ ---------------------------------------
# ⚠️ ყველაზე მნიშვნელოვანი ცვლადი ამ ფაილში.
# დეპლოიზე **აუცილებლად** `production` (ან `staging`). თუ არ დააყენე,
# ნაგულისხმევი `development` ერთდროულად ხსნის ხუთივე დაცვას:
#   /docs და /openapi.json საჯარო ხდება (მთელი admin API-ს სქემა)
#   refresh cookie კარგავს `Secure`-ს
#   სურათები პროცესის მეხსიერებაში იწერება და ქრება
#   FORWARDED_ALLOW_IPS-ისა და კავშირების ბიუჯეტის შემოწმებები გამოტოვდება
# ამიტომ gunicorn სახელდაუდებელ გარემოში გაშვებაზე ჩერდება.
APP_ENV=development

# ვის უშვებს ბრაუზერი API-სთან. დეპლოიზე აქ frontend-ის რეალური დომენი უნდა
# ეწეროს — ნაგულისხმევი localhost-ით ცოცხალი საიტი CORS-ზე ჩავარდება.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# რომელ `Host` header-ს მიიღოს. `*` = შემოწმება სრულად გამორთულია — სერვერი
# ნებისმიერ სახელზე პასუხობს.
# ⚠️ დეპლოიზე სავალდებულოა: `*`-ით ან ცარიელით gunicorn გაშვებაზე ჩერდება.
# რეალური დომენები, მძიმით: voltbox.ge,www.voltbox.ge
TRUSTED_HOSTS=*

# ბაზასთან TLS. `require` შიფრავს, მაგრამ სერვერს **არ ამოწმებს** (MITM-ისგან
# არ იცავს). `verify-full` სრული დაცვაა და ითხოვს DB_SSL_ROOT_CERT-ს:
# Supabase → Settings → Database → SSL Configuration → Download.
DB_SSL_MODE=require
DB_SSL_ROOT_CERT=

# ⚠️ `true` ყველა SQL-ს ლოგავს პარამეტრებთან ერთად — ანუ მომხმარებლის
# მონაცემებიც ლოგში მოხვდება. დეპლოიზე არასოდეს.
DB_ECHO=false

# --- სიხშირის შეზღუდვა ------------------------------------------------------
# ცარიელი = მთვლელები პროცესის მეხსიერებაში. ეს მხოლოდ ერთი პროცესისთვისაა
# სწორი; Dockerfile ორ worker-ს უშვებს, ანუ „5 შესვლა წუთში" ათად იქცევა.
REDIS_URL=

# ვის უნდა დაუჯეროს gunicorn-მა კლიენტის IP-ის შესახებ (`X-Forwarded-For`).
# ⚠️ production/staging-ში სავალდებულოა — თუ არ არის, სერვერი გაშვებაზე
# ჩერდება (იხ. gunicorn.conf.py). `*` აკრძალულია: მაშინ ნებისმიერს შეუძლია
# header-ით თავისი IP აირჩიოს და ლიმიტს გვერდი აუაროს.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- ბაზის კავშირები --------------------------------------------------------
# თითო worker თავის pool-ს ატარებს, ამიტომ დაკავებული კავშირების ჭერია
#
#     WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
#
# ნაგულისხმევად: 2 x (5 + 10) = 30.
#
# Supabase-ის მცირე ინსტანსი 60-ს უშვებს, საიდანაც 3 superuser-ისთვისაა
# დაცული და ~20-ს თვითონ Supabase-ის სერვისები იკავებენ (PostgREST, Realtime,
# Storage, GoTrue). დარჩენილი ჩვენია.
#
# ⚠️ ლიმიტს რომ გადააჭარბო, Postgres ახალ კავშირს აღარ მიიღებს — საიტი
# დატვირთვისას შემთხვევით 500-ებს დააბრუნებს და შეცდომაში pool არსად ჩანს.
# ამიტომ gunicorn გაშვებაზე ამ არითმეტიკას ამოწმებს (gunicorn.conf.py).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# ჯამური ბიუჯეტი. 0 = შემოწმება გამორთულია (ბაზა სხვას არ უზიარებ).
DB_CONNECTION_BUDGET=30

SHIPPING_FREE_THRESHOLD=150
SHIPPING_FLAT_FEE=5
LOW_STOCK_THRESHOLD=3
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=100

# 3. Supabase Storage — პროდუქტების სურათებისთვის.
# ⚠️ დეპლოიზე სავალდებულოა. ორივეს გარეშე backend production-ში საერთოდ არ
# გაეშვება (სურათები მეხსიერებაში ჩაიწერებოდა და დაიკარგებოდა).
# SERVICE_ROLE_KEY მხოლოდ backend-ზეა — ბრაუზერში არასოდეს.
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ატვირთვის ზღვრები — დიდი ფაილითა და „pixel bomb"-ით დატვირთვისგან.
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=50000000

# --- ავტორიზაცია -----------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ბრუტფორსი ანგარიშზე. `/auth/login`-ის ლიმიტი IP-ზე ითვლის, ათასი ნაქირავები
# proxy კი ათასჯერ მეტ ცდას იძლევა ერთ ელ. ფოსტაზე. ეს მთვლელი ანგარიშზეა —
# ერთადერთი, რაც ყველა მცდელობას საერთო აქვს.
#
# ⚠️ ფასი: ვინც ელ. ფოსტას იცის, შეუძლია ანგარიში განგებ ჩაკეტოს. ეს დროებითია
# (ვადა თავისით გადის) და არსებულ სესიას არ ეხება — refresh აქ არ გადის.
MAX_FAILED_LOGINS=10
LOGIN_LOCK_MINUTES=15

# refresh-ტოკენი httpOnly cookie-ში მიდის — JavaScript-ს ის არასოდეს ხედავს.
# ცარიელი Secure = „უსაფრთხო, თუ ეს development ან test არ არის". Secure cookie
# ჩვეულებრივ http-ზე ბრაუზერს საერთოდ არ ინახავს, ანუ ლოკალური შესვლა ჩუმად
# ჩავარდებოდა.
REFRESH_COOKIE_NAME=voltbox_refresh
REFRESH_COOKIE_SECURE=
REFRESH_COOKIE_SAMESITE=strict
# ცარიელი = `{API_V1_PREFIX}/auth`. თუ proxy API-ს სხვა გარე prefix-ით აწვდის,
# აქ ის ჩაწერე — cookie-ს Path ისეთი უნდა იყოს, როგორსაც *ბრაუზერი* ხედავს.
REFRESH_COOKIE_PATH=
