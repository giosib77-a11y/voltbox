# ─────────────────────────────────────────────────────────────────────────────
#  VoltBox backend — ლოკალური კონფიგი.  ⚠️ ეს ფაილი git-ში არ ხვდება.
# ─────────────────────────────────────────────────────────────────────────────

# 1. ჩასვი Supabase-ის Session pooler URI და [YOUR-PASSWORD] შეცვალე რეალურით.
#    სქემას (`postgresql://` → `postgresql+asyncpg://`) კოდი თვითონ გადააკეთებს,
#    ასე რომ ზუსტად ისე ჩასვი, როგორც Supabase-მა მოგცა.
# ---- აქტიური კავშირი -------------------------------------------------------
# ლოკალური Postgres (Docker) — დეველოპმენტისა და ტესტებისთვის
DATABASE_URL=postgresql://voltbox:voltbox@localhost:55432/voltbox

# Supabase-ზე გადასართავად: ზემოთა ხაზი დააკომენტარე და ეს გაააქტიურე
# (Session pooler URI, [YOUR-PASSWORD] რეალურით ჩანაცვლებული)
# DATABASE_URL=postgresql://postgres.jnfokdczfpcysnqiwask:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# 2. JWT-ის ხელმოწერის გასაღები — ქვემოთ დაგენერირებული მნიშვნელობა.
JWT_SECRET=  # python -c "import secrets;print(secrets.token_urlsafe(48))"

# --- დანარჩენს ნაგულისხმევად ვტოვებთ ---------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- სიხშირის შეზღუდვა ------------------------------------------------------
# ცარიელი = მთვლელები პროცესის მეხსიერებაში. ეს მხოლოდ ერთი პროცესისთვისაა
# სწორი; Dockerfile ორ worker-ს უშვებს, ანუ „5 შესვლა წუთში" ათად იქცევა.
REDIS_URL=

# ვის უნდა დაუჯეროს gunicorn-მა კლიენტის IP-ის შესახებ (`X-Forwarded-For`).
# ⚠️ production/staging-ში სავალდებულოა — თუ არ არის, სერვერი გაშვებაზე
# ჩერდება (იხ. gunicorn.conf.py). `*` აკრძალულია: მაშინ ნებისმიერს შეუძლია
# header-ით თავისი IP აირჩიოს და ლიმიტს გვერდი აუაროს.
FORWARDED_ALLOW_IPS=127.0.0.1
SHIPPING_FREE_THRESHOLD=150
SHIPPING_FLAT_FEE=5
LOW_STOCK_THRESHOLD=3
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=100

# 3. (არასავალდებულო, მოგვიანებით) Supabase Storage-ისთვის — ახლა არ გვჭირდება.
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=

# --- ავტორიზაცია -----------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
