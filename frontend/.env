# Data layer switch: "mock" (in-memory) | "http" (real REST backend)
#
#   mock — backend საერთოდ არ სჭირდება, 61 სატესტო პროდუქტი მეხსიერებიდან
#   http — რეალური API. სჭირდება გაშვებული backend (uvicorn :8000)
VITE_API_MODE=http

# Used only when VITE_API_MODE=http
#
# შედარებითი გზა (`/api/v1`) — Vite-ის proxy-ზე გადის. ngrok-ით გაზიარებისას
# ერთადერთი მომუშავე ვარიანტია: სტუმრის ბრაუზერი `localhost`-ს ვერ ნახავს.
# აბსოლუტური (`http://localhost:8000/api/v1`) — მხოლოდ შენს კომპიუტერზე.
VITE_API_BASE_URL=/api/v1
