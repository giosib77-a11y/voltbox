# Data layer switch: "mock" (in-memory) | "http" (real REST backend)
#
#   mock — backend საერთოდ არ სჭირდება, 61 სატესტო პროდუქტი მეხსიერებიდან
#   http — რეალური API. სჭირდება გაშვებული backend (uvicorn :8000)
#
# არჩევანი ბილდის დროს ხდება (vite.config.js → resolve.alias), ამიტომ
# ცვლილების შემდეგ dev/preview სერვერი თავიდან უნდა გაეშვას.
VITE_API_MODE=mock

# Used only when VITE_API_MODE=http
#
#   /api/v1                        — Vite-ის proxy-ზე გადის. ngrok-ით
#                                    გაზიარებისას ერთადერთი მომუშავე ვარიანტია:
#                                    სტუმრის ბრაუზერი `localhost`-ს ვერ ნახავს.
#   http://localhost:8000/api/v1   — პირდაპირ backend-ზე, მხოლოდ შენს კომპიუტერზე.
#                                    ითხოვს, რომ backend-ის CORS_ORIGINS-ში
#                                    frontend-ის მისამართი ეწეროს.
VITE_API_BASE_URL=/api/v1
