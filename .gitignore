# ── ყველგან ─────────────────────────────────────────────────────────────
.DS_Store
*.local
.vscode/*
!.vscode/extensions.json

# ── frontend (Node / Vite) ──────────────────────────────────────────────
# ძირში `package.json` განზრახ არ დევს (იხ. ASSUMPTIONS.md §9.2), მაგრამ
# შემთხვევით გაშვებული `npm install` მაინც არ უნდა მოხვდეს git-ში.
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env.local
frontend/.env.*.local
npm-debug.log*
yarn-error.log*

# ── backend (Python / FastAPI) ──────────────────────────────────────────
# .env საიდუმლოს შეიცავს (Supabase-ის პაროლი, JWT_SECRET) — არასოდეს კომიტდება.
# ნიმუშისთვის: backend/.env.example
backend/.env
backend/.venv/
backend/**/__pycache__/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# seed / იმპორტის დროებითი ფაილები
backend/_mock.json
backend/_mock.err
backend/*.tmp
backend/products.json

# export_mock_data.mjs-ის გამონატანი (CI-ში და ხელით გაშვებისას)
mock.json

# ერთჯერადი, `alembic upgrade --sql`-ით დაგენერირებული ფაილები
backend/supabase-*.sql
