# ── backend (Python / FastAPI) ──────────────────────────────────────────
# .env საიდუმლოს შეიცავს (Supabase-ის პაროლი, JWT_SECRET) — არასოდეს კომიტდება.
# ნიმუშისთვის: backend/.env.example
backend/.env
backend/.venv/
backend/**/__pycache__/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# seed / იმპორტის დროებითი ფაილები
backend/_mock.json
backend/_mock.err
backend/*.tmp
backend/products.json
